#!/usr/bin/env node

/**
 * Internet do Zero CLI — "in"
 * Comandos rápidos para o senhor capturar pensamentos e publicar no blog.
 */

import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const postsFilePath = path.join(__dirname, 'src', 'modules', 'blog', 'data', 'initialPosts.js');

function showHelp() {
  console.log(`
\x1b[32m\x1b[1mInternet do Zero CLI — in\x1b[0m

\x1b[36mComandos:\x1b[0m
  \x1b[33min capture "<texto>"\x1b[0m
    Grava um pensamento rápido no blog.
    Ex: in capture "Hoje eu 'tô com uma preguiça"

  \x1b[33min post --article "<Título>" --content "<Texto>" [--en "<Texto EN>"]\x1b[0m
    Publica um novo artigo (com suporte a versão em inglês).

  \x1b[33min post --story "<Título>" --content "<Texto>"\x1b[0m
    Publica uma nova crônica / história autoral.

  \x1b[33min list\x1b[0m
    Lista as publicações recentes.
`);
}

async function readPosts() {
  if (!fs.existsSync(postsFilePath)) return [];
  const content = fs.readFileSync(postsFilePath, 'utf-8');
  const jsonPart = content.replace(/^export const initialPosts =\s*/, '').replace(/;\s*$/, '');
  try {
    return eval(`(${jsonPart})`);
  } catch (err) {
    console.error('Erro ao ler posts:', err.message);
    return [];
  }
}

function writePosts(posts) {
  const fileContent = `export const initialPosts = ${JSON.stringify(posts, null, 2)};\n`;
  fs.writeFileSync(postsFilePath, fileContent, 'utf-8');
}

const args = process.argv.slice(2);
const command = args[0];

if (!command || command === 'help' || command === '--help') {
  showHelp();
  process.exit(0);
}

if (command === 'capture') {
  const text = args[1];
  if (!text) {
    console.error('\x1b[31mErro: Forneça o texto do pensamento. Ex: in capture "Texto..."\x1b[0m');
    process.exit(1);
  }

  const posts = await readPosts();
  const newThought = {
    id: `thought-${Date.now()}`,
    type: 'thought',
    content: text,
    author: 'senhor',
    createdAt: new Date().toISOString(),
    likes: 0,
    comments: []
  };

  posts.unshift(newThought);
  writePosts(posts);
  console.log(`\x1b[32m✓ Pensamento capturado com sucesso no Internet do Zero!\x1b[0m`);
  console.log(`  \x1b[90m"${text}"\x1b[0m`);
  process.exit(0);
}

if (command === 'list') {
  const posts = await readPosts();
  console.log(`\x1b[32mTotal de publicações: ${posts.length}\x1b[0m\n`);
  posts.slice(0, 5).forEach((p) => {
    const title = p.title || p.title_pt || p.content?.slice(0, 40) + '...';
    console.log(`  [${p.type.toUpperCase()}] ${title} (${p.likes || 0} likes)`);
  });
  process.exit(0);
}

showHelp();
